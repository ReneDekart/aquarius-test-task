{
  "name": "aq-test-task",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "node"
  ],
  "scripts": {
    "install-all": "npm install --legacy-peer-deps --silent",
    "start-server": "npm run start --workspace node",
    "start-client": "npm run serve --workspace client",
    "build-client": "npm run build --workspace client",
    "preview-client": "npm run preview --workspace client",
    "env-up": "concurrently \" npm run start-server \" &  \" npm run start-client \" "
  },
  "author": "Artem Gorbachev",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
